{
  "expo": {
    "name": "PhysLens",
    "slug": "physics_visualizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/home-icon.png",
    "scheme": "physicsvisualizer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/home-icon.png",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PhysLens connects to the local development server to analyze images.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.claraliu990.physics-visualizer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C7C3BD",
          "image": "./assets/images/home-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
